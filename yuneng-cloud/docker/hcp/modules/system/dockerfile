# 基础镜像
FROM eclipse-temurin:8-jre-jammy
# author
MAINTAINER hcp

# Application jar belongs to the image; an anonymous volume here preserves stale jars on recreate.
# 创建目录
RUN mkdir -p /home/hcp
# 指定路径
WORKDIR /home/hcp
# 复制jar文件到路径
COPY ./jar/hcp-system.jar /home/hcp/hcp-system.jar
# 启动系统服务
ENTRYPOINT ["java","-jar","hcp-system.jar"]
